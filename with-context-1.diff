+
+    with pytest.raises((TypeError, ValueError)):
+        feature_extractor_module.ObjectExtractor(min_confidence=value)
+    with pytest.raises((TypeError, ValueError)):
+        feature_extractor_module.SceneExtractor(min_confidence=value)
+    assert loaded == []
